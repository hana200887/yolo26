flowchart LR
    source["Street traffic.webm<br/>CC BY 3.0"] --> manifest["Provenance JSON<br/>URL, tác giả, license, SHA-256"]
    manifest --> run["Lượt chạy cục bộ<br/>YOLO26 + ByteTrack"]
