    truth --> matcher
    matcher --> metrics["Precision (độ chính xác): 0.20<br/>Recall (độ thu hồi): 1.00<br/>F1: 0.333"]
    metrics --> caveat["Lát cắt pilot<br/>không phải benchmark tổng quát"]

